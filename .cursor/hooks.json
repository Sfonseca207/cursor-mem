{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "bash scripts/cursor-mem-hook.sh session-init",
        "timeout": 5
      }
    ],
    "afterShellExecution": [
      {
        "command": "bash scripts/cursor-mem-hook.sh observation",
        "timeout": 10
      }
    ],
    "afterMCPExecution": [
      {
        "command": "bash scripts/cursor-mem-hook.sh observation",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "bash scripts/cursor-mem-hook.sh file-edit",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "bash scripts/cursor-mem-hook.sh summarize",
        "timeout": 10,
        "loop_limit": 0
      }
    ]
  }
}
